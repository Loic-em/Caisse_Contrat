# Copier ce fichier vers .env, puis renseigner les identifiants locaux.
# Ce compte n'est créé que si aucun administrateur n'existe déjà.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=

# Active les comptes de démonstration uniquement avec le profil local.
# Le même mot de passe démo est attribué aux comptes de test; ne le réutilisez pas.
APP_DEMO_ACCOUNTS_ENABLED=false
APP_DEMO_ACCOUNT_PASSWORD=
APP_ANTIVIRUS_CLAMD_HOST=
APP_ANTIVIRUS_CLAMD_PORT=3310
# Générer une clé aléatoire Base64 de 32 octets pour chiffrer les PDF de contrats.
# Garder cette clé hors du dépôt et la sauvegarder séparément de la base de données.
APP_CONTRACTS_ENCRYPTION_KEY=
# Générer une clé aléatoire Base64 distincte de 32 octets pour les justificatifs.
# La sauvegarder hors du dépôt, séparément de la base de données.
APP_CASH_DOCUMENTS_ENCRYPTION_KEY=

# Longueur minimale d'un motif de rejet de demande de caisse (paramètre PAR-06).
APP_CASH_REJECTION_MIN_LENGTH=10

# Premier numéro attribué aux bons (PAR-14 + 1 avant mise en service).
APP_CASH_VOUCHER_FIRST_NUMBER=1

# Réauthentification obligatoire avant chaque visa (paramètre PAR-02).
APP_CASH_VISA_REAUTH_MINUTES=5
